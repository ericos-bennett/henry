# LLM provider/model used for job extraction, plus the API key for whichever
# provider LLM_PROVIDER names. Supported providers: 'gemini', 'claude'.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Postgres connection string
DATABASE_URL=postgresql://user@localhost:5432/career_scraper

# SMTP config for job-notification emails (sent when a scrape finds a job that's
# both new and matches your saved preferences). Any SMTP-capable provider works —
# a dedicated Gmail account with an app password, AWS SES's SMTP interface,
# Mailgun, Postmark, etc. Leave blank to skip email notifications entirely.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Set DJANGO_DEBUG=true for local development. Leave blank/false for production - then
# DJANGO_SECRET_KEY below is required (startup fails without it). Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=

# Set DJANGO_SECURE_SSL=true only once a proxy (Caddy) terminates HTTPS in front of
# the app - it turns on secure-only cookies and HSTS.
DJANGO_SECURE_SSL=

# Comma-separated hosts Django will accept requests for. Leave blank for localhost-only
# (Django's default). Set to e.g. your LAN IP to reach a dev server from another
# machine, or the public hostname in production.
DJANGO_ALLOWED_HOSTS=

# Address manage.py runserver binds to. Defaults to 127.0.0.1:8000 behavior; set to
# 0.0.0.0:8000 to accept connections from other machines on the LAN.
DJANGO_RUNSERVER_ADDR=

# Comma-separated full origins (scheme://host:port) allowed to make POST/PATCH/DELETE
# requests, beyond Django's default same-origin check. Not needed for the normal LAN
# setup - only for edge cases like hitting the backend directly on its own port.
DJANGO_CSRF_TRUSTED_ORIGINS=

# OpenTelemetry export config. Point at an otel-lgtm (or other OTLP) collector; see
# otel-start.sh at the repo root.
OTEL_SERVICE_NAME=henry-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_PYTHON_LOG_CORRELATION=true
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
