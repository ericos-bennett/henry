# Key for whichever provider config/settings.yaml's settings.llm.provider currently points to.
LLM_API_KEY=

# Postgres connection string
DATABASE_URL=postgresql://user@localhost:5432/career_scraper

# Comma-separated hosts Django will accept requests for. Leave blank for localhost-only
# (Django's default). Set to e.g. your LAN IP to reach a dev server from another machine.
DJANGO_ALLOWED_HOSTS=

# Address manage.py runserver binds to. Defaults to 127.0.0.1:8000 behavior; set to
# 0.0.0.0:8000 to accept connections from other machines on the LAN.
DJANGO_RUNSERVER_ADDR=

# Comma-separated full origins (scheme://host:port) allowed to make POST/PATCH/DELETE
# requests, beyond Django's default same-origin check. Not needed for the normal LAN
# setup - only for edge cases like hitting the backend directly on its own port.
DJANGO_CSRF_TRUSTED_ORIGINS=

# OpenTelemetry export config. Point at an otel-lgtm (or other OTLP) collector; see
# otel-start.sh at the repo root.
OTEL_SERVICE_NAME=henry-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_PYTHON_LOG_CORRELATION=true
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
