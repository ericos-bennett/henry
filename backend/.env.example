# Key for whichever provider config/settings.yaml's settings.llm.provider currently points to.
LLM_API_KEY=

# Postgres connection string
DATABASE_URL=postgresql://user@localhost:5432/career_scraper

# Comma-separated hosts Django will accept requests for. Leave blank for localhost-only
# (Django's default). Set to e.g. your LAN IP to reach a dev server from another machine.
DJANGO_ALLOWED_HOSTS=

# Address manage.py runserver binds to. Defaults to 127.0.0.1:8000 behavior; set to
# 0.0.0.0:8000 to accept connections from other machines on the LAN.
DJANGO_RUNSERVER_ADDR=
