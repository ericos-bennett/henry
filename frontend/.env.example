# Host the Vite dev server binds to. Defaults to 127.0.0.1 (localhost-only); set to
# 0.0.0.0 to accept connections from other machines on the LAN.
VITE_HOST=

# Comma-separated extra Host headers the dev server accepts, beyond localhost /
# 127.0.0.1 (e.g. a LAN hostname, or henry.fourthwallride.com when proxied).
DEV_ALLOWED_HOSTS=

# Where the dev server proxies /api/* — the Django backend address.
# Defaults to http://127.0.0.1:8000.
DEV_API_TARGET=
